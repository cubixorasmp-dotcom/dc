# Discord Developer Portal token. Keep this in Replit Secrets or Render environment variables.
DISCORD_TOKEN=

# Optional: application owner IDs, comma-separated. These users can manage bot owners.
OWNER_IDS=

# Optional runtime settings
PREFIX=e!
PORT=3000
SITE_URL=https://cubixoraweb.onrender.com
DATA_DIR=data

# Minecraft Bedrock status defaults requested for Cubixora SMP
MC_HOST=cubixorasmp.play.hosting
MC_PORT=19132
MC_EDITION=bedrock
MC_STATUS_INTERVAL_MS=60000

# Set this only if your Minecraft bridge/plugin sends events to /mc/events
MC_WEBHOOK_SECRET=